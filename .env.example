# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM providers (set the one selected in config.yaml -> llm.provider) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Market data & news ---
ALPHA_VANTAGE_API_KEY=
TAVILY_API_KEY=

# --- Vector store (optional; FAISS is the default and needs nothing) ---
# Qdrant Cloud cluster URL, e.g. https://xxxx.cloud.qdrant.io:6333 — leave empty to use local mode
QDRANT_URL=
QDRANT_API_KEY=

# --- Tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finnie
